        "messages": {
          "values": [
            {
              "content": "=You are an experienced HR recruiter.\n\nYour task is to evaluate candidates objectively against the supplied job requirements.\n\nJob Title:\n{{ $json.jobTitle }}\n\nJob Description:\n{{ $json.jobDescription }}\n\nCandidate Resume:\n\n{{ $json.text }}\n\nInstructions:\n\n1. Compare the candidate's resume with the job description.\n2. Evaluate:\n   - Skills match\n   - Years of experience\n   - Relevant work history\n   - Education (if relevant)\n   - Overall suitability\n3. Give the candidate a score from 0–100.\n4. If the score is greater than or equal to {{ $json.qualificationThreshold }}, set \"qualified\" to true.\n5. Otherwise set \"qualified\" to false.\n\nReturn ONLY valid JSON.\n\n{\n  \"candidateName\": \"\",\n  \"score\": 0,\n  \"qualified\": false,\n  \"skillsMatched\": [],\n  \"missingSkills\": [],\n  \"experienceSummary\": \"\",\n  \"strengths\": [],\n  \"weaknesses\": [],\n  \"reason\": \"\"\n}"
            }
          ]
        },
        "jsonOutput": true,
        "builtInTools": {},
        "options": {}
